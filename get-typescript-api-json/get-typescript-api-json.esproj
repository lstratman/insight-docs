<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/0.5.89-alpha">
  <PropertyGroup>
    <!--Command to run on project build-->
    <BuildCommand></BuildCommand>
    <RunNPMBuild Condition="'$(RunNPMBuild)' == ''">true</RunNPMBuild>
    <RunNPMInstall Condition="'$(RunNPMInstall)' == ''">true</RunNPMInstall>
    <!--Command to run on project clean-->
    <CleanCommand>npm run clean</CleanCommand>
    <OutDir>obj\$(Configuration)</OutDir>
  </PropertyGroup>

  <Import Project="./NPM.targets"/>

  <Target Name="SetPropertiesForEsproj" BeforeTargets="GetReferenceAssemblyPaths">
    <CreateProperty Value="v8.0">
      <Output TaskParameter="Value" PropertyName="TargetFrameworkVersion" />
    </CreateProperty>
    <CreateProperty Value="">
      <Output TaskParameter="Value" PropertyName="TargetFrameworkMoniker" />
    </CreateProperty>
  </Target>
</Project>