@using InsightDocs.Site.Abstractions
@using Microsoft.Extensions.DependencyInjection

@inherits InsightDocs.RazorTemplate<InsightDocs.Site.Model.SiteIndex>

<html>
<head>
    <title>@Item!.Title</title>

    @if (Item.FaviconAsset != null)
    {
        <link rel="icon" type="image/png" href="@GetUrl(Item.FaviconAsset)" />
        <link rel="apple-touch-icon" href="@GetUrl(Item.FaviconAsset)" />
    }

    <script type="text/javascript" src="@GetUrl(TemplateAssets.SiteIndexScript)"></script>

    <link rel="stylesheet" href="@GetUrl(TemplateAssets.MicrosoftLearnCss)" />
    <link rel="stylesheet" href="@GetUrl(TemplateAssets.SiteIndexCss)" />

    @AddAdditionalCss()

    @AddAdditionalJavaScript()

    @if (!String.IsNullOrEmpty(Item.InitialUrl))
    {
        <script type="text/javascript">
            function loadInitialUrl() {
                if (!document.location.hash || document.location.hash === '#') {
                    document.getElementById('topicContentIFrame').src = '@(Item.InitialUrl)';
                }
            }
        </script>
    }

    else
    {
        <script type="text/javascript">
            function loadInitialUrl() {
            }
        </script>
    }
</head>
<body onload="onSiteIndexLoad(); loadInitialUrl();">
    @{
        ISiteHeaderProvider? headerProvider = ServiceProvider.GetService<ISiteHeaderProvider>();

        if (headerProvider != null)
        {
            <div id="header">@Raw(headerProvider.GetHeader())</div>
        }
    }

    <div id="mainContent">
        <div id="navbar"></div>
        <div id="navbarResizeBar" onmousedown="navbarStartResize(event)"></div>
        <div id="topicContent">
            <iframe name="topicContentIFrame" id="topicContentIFrame" src="about:blank"></iframe>
        </div>
    </div>
</body>
</html>