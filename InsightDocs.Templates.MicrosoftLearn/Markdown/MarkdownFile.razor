@using System.Text.RegularExpressions
@inherits InsightDocs.RazorTemplate<InsightDocs.Markdown.Model.MarkdownFile>
@inject InsightDocs.Abstractions.ICodeLanguageService CodeLanguageService

<html>
<head>
    <link rel="stylesheet" href="@GetUrl(TemplateAssets.MsdnCss)" />

    @AddAdditionalCss()

    <script type="text/javascript" src="@GetUrl(TemplateAssets.CommonScript)"></script>
    <script type="text/javascript" src="@GetUrl(TemplateAssets.HighlightJsScript)"></script>

    @AddAdditionalJavaScript()
            
    <script type="text/javascript">hljs.highlightAll();</script>
</head>
<body>
    <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
        <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
			<div>
                <div class="content">
                    <div data-chunk-ids="0">
                        @{
                            string html = Item!.Html!.Replace("<table", "<table class=\"table\"").Replace("<code class=\"language-", "<code class=\"lang-");

                            html = Regex.Replace(html, @"<h(?<level>\d+)(?<otherAttributes>[^>]*)id=[""'](?<id>[^""']+)[""'](?<otherAttributes2>[^>]*)>(?<title>.*?)</h\d+>", (evaluator) =>
                            {
                                string id = evaluator.Groups["id"].Value;
                                string title = evaluator.Groups["title"].Value;
                                int level = int.Parse(evaluator.Groups["level"].Value);

                                if (level == 1)
                                {
                                    return evaluator.Value;
                                }

                                return $@"<div class=""heading-wrapper"" data-heading-level=""h{level}"">
    <a class=""anchor-link docon docon-link"" href=""#{id}""></a>
    {evaluator.Value}
</div>";
                            });

                            html = Regex.Replace(html, @"<a href=""(?<protocol>http\:|https\:)", evaluator =>
                            {
                                return "<a target=\"_new\" href=\"" + evaluator.Groups["protocol"];
                            });

                            html = Regex.Replace(html, @"<pre><code class=""lang-(?<languageId>[^\""]+)", match =>
                            {
                                string languageId = match.Groups["languageId"].Value;
                                string languageTitle = CodeLanguageService.GetTitle(languageId);

                                return $@"<div class=""codeHeader"">
    <span class=""language"">{languageTitle}</span>
    <button type=""button"" class=""action position-relative display-none-print"" onclick=""copyCodeBlock(event)"">
        <span class=""icon margin-right-xxs"" aria-hidden=""true"">
            <span class=""docon docon-edit-copy""></span>
        </span>
        <span>Copy</span>
        <div class=""successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent"" aria-hidden=""true"">
            <span class=""icon font-size-lg"">
                <span class=""docon docon-check-mark""></span>
            </span>
        </div>
    </button>
</div>
<pre class=""wrap has-inner-focus""><code class=""lang-{languageId}";
                            });
                        }

                        @Raw(html)
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>