@inherits InsightDocs.RazorTemplate<InsightDocs.OpenApi.Model.OpenApiOperation>
@using InsightDocs.Abstractions
@using InsightDocs.DotNet.Model
@using InsightDocs.OpenApi
@using InsightDocs.Templates.MicrosoftLearn.Components
@using Microsoft.Extensions.DependencyInjection

<html>
    <head>
        <link rel="stylesheet" href="@GetUrl(TemplateAssets.MicrosoftLearnCss)"/>

        @AddAdditionalCss()

        <script type="text/javascript" src="@GetUrl(TemplateAssets.HighlightJsScript)"></script>
        <script type="text/javascript" src="@GetUrl(TemplateAssets.CommonScript)"></script>

        @AddAdditionalJavaScript()

        <script type="text/javascript">hljs.highlightAll();</script>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.Method @Item.Url</h1>

                            <div class="margin-block-xxs">
	                            <ul class="metadata page-metadata align-items-center">
		                            <li>Reference</li>
	                            </ul>
                            </div>

                            <h2>Definition</h2>

                            @if (Item!.Description != null)
                            {
                                <div class="summaryHolder">@Raw(Item.Description)</div>
                            }

                            @if (Item.Parameters != null)
                            {
                                var requiredParameters = Item.Parameters.Where(p => p.IsRequired).OrderBy(p => p.Name).ToList();
                                var optionalParameters = Item.Parameters.Where(p => !p.IsRequired).OrderBy(p => p.Name).ToList();

                                if (requiredParameters.Count > 0)
                                {
                                    <h3 class="propertyInfoTitle stack heading-anchor" id="required-parameters">Required Parameters</h3>

                                    @for (int i = 0; i < requiredParameters.Count; i++)
                                    {
                                        <div class="@(i == 0 ? "propertyInfo" : "propertyInfo stack")">
                                            <dl class="parameterList">
                                                <dt>@requiredParameters[i].Name</dt>
                                                <dd>
                                                    @if (requiredParameters[i].Schema != null)
                                                    {
                                                        if (requiredParameters[i].Schema is Microsoft.OpenApi.OpenApiSchemaReference)
                                                        {
                                                            <!-- TODO: reference link -->
                                                        }

                                                        else if (requiredParameters[i].Schema!.Type != null && requiredParameters[i].Schema!.Enum != null)
                                                        {
                                                            @Raw("Enum");
                                                        }

                                                        else if (requiredParameters[i].Schema!.Type != null)
                                                        {
                                                            @requiredParameters[i].Schema!.Type!.ToString()
                                                        }
                                                    }
                                                </dd>
                                            </dl>

                                            <p>
                                                <b>Location:</b> @requiredParameters[i].Location.ToString("G")
                                                <!-- TODO: enum values -->
                                            </p>

                                            @if (requiredParameters[i].Description != null)
                                            {
                                                @Raw(requiredParameters[i].Description!, "p")
                                            }

                                            <!-- TODO: object schema -->
                                        </div>
                                    }
                                }

                                if (optionalParameters.Count > 0)
                                {
                                    <h3 class="propertyInfoTitle stack heading-anchor" id="optional-parameters">Optional Parameters</h3>

                                    @for (int i = 0; i < optionalParameters.Count; i++)
                                    {
                                        <div class="@(i == 0 ? "propertyInfo" : "propertyInfo stack")">
                                            <dl class="parameterList">
                                                <dt>@optionalParameters[i].Name</dt>
                                                <dd>
                                                    @if (optionalParameters[i].Schema != null)
                                                    {
                                                        if (optionalParameters[i].Schema is Microsoft.OpenApi.OpenApiSchemaReference)
                                                        {
                                                            <!-- TODO: reference link -->
                                                        }

                                                        else if (optionalParameters[i].Schema!.Type != null && optionalParameters[i].Schema!.Enum != null)
                                                        {
                                                            @Raw("Enum");
                                                        }

                                                        else if (optionalParameters[i].Schema!.Type != null)
                                                        {
                                                            @optionalParameters[i].Schema!.Type!.ToString()
                                                        }
                                                    }
                                                </dd>
                                            </dl>

                                            <p><b>Location:</b> @optionalParameters[i].Location.ToString("G")</p>

                                            @if (optionalParameters[i].Description != null)
                                            {
                                                @Raw(optionalParameters[i].Description!, "p")
                                            }
                                        </div>
                                    }
                                }
                            }

                            @if (Item.Responses != null && Item.Responses.Count > 0)
                            {
                                <h2 class="propertyInfoTitle stack heading-anchor" id="responses">Responses</h2>

                                @foreach (var response in Item.Responses.OrderBy(r => r.HttpStatusCode))
                                {
                                    <h3 class="propertyInfoTitle stack heading-anchor" id="@response.HttpStatusCode">HTTP @response.HttpStatusCode</h3>

                                    @if (response.Description != null)
                                    {
                                        <div class="summaryHolder">@Raw(response.Description)</div>
                                    }

                                    @if (response.Content != null && response.Content.Count > 0)
                                    {
                                        foreach (var content in response.Content)
                                        {
                                            <h4 class="propertyInfoTitle">@content.MimeType</h4>

                                            if (content.Schema is Microsoft.OpenApi.OpenApiSchemaReference)
                                            {
                                                <!-- TODO: reference link -->
                                            }

                                            else if (content.Schema!.Type != null && content.Schema!.Enum != null)
                                            {
                                                <!-- TODO: enum values -->
                                            }

                                            else if (content.Schema!.Type != null && content.Schema!.Type != Microsoft.OpenApi.JsonSchemaType.Object)
                                            {
                                                @Raw(content.Schema!.Type!.ToString()!)
                                            }

                                            else if (content.Schema!.Type == Microsoft.OpenApi.JsonSchemaType.Object && content.MimeType == "application/json")
                                            {
                                                <div class="codeHeader">
                                                    <span class="language">JSON Schema</span>
                                                    <button type="button" class="action position-relative display-none-print" onclick="copyCodeBlock(event)">
                                                        <span class="icon margin-right-xxs" aria-hidden="true">
                                                            <span class="docon docon-edit-copy"></span>
                                                        </span>
                                                        <span>Copy</span>
                                                        <div class="successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent" aria-hidden="true">
                                                            <span class="icon font-size-lg">
                                                                <span class="docon docon-check-mark"></span>
                                                            </span>
                                                        </div>
                                                    </button>
                                                </div>
                                                <pre class="wrap has-inner-focus"><code class="json language-json" dir="ltr">@content.Schema.ToJsonSchemaText()</code></pre>
                                            }
                                        }
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>