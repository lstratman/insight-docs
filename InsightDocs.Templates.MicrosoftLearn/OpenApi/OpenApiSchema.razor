@inherits InsightDocs.RazorTemplate<InsightDocs.OpenApi.Model.OpenApiSchema>
@inject InsightDocs.Abstractions.IUrlProvider<InsightDocs.OpenApi.Model.OpenApiSchema> OpenApiSchemaUrlProvider
@using InsightDocs.Abstractions
@using InsightDocs.OpenApi
@using InsightDocs.Templates.MicrosoftLearn.Components
@using Microsoft.Extensions.DependencyInjection

<html>
    <head>
        <link rel="stylesheet" href="@GetUrl(TemplateAssets.MicrosoftLearnCss)"/>
        <link rel="stylesheet" href="@GetUrl(TemplateAssets.OpenApiCss)"/>

        @AddAdditionalCss()

        <script type="text/javascript" src="@GetUrl(TemplateAssets.HighlightJsScript)"></script>
        <script type="text/javascript" src="@GetUrl(TemplateAssets.CommonScript)"></script>
        <script type="text/javascript" src="@GetUrl(TemplateAssets.OpenApiScript)"></script>

        @AddAdditionalJavaScript()

        <script type="text/javascript">
            hljs.highlightAll();

            window.addEventListener('DOMContentLoaded', function () {
                addSchemaReferenceLinks();
            });
        </script>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.Name Schema</h1>

                            <div class="margin-block-xxs">
	                            <ul class="metadata page-metadata align-items-center">
		                            <li>Reference</li>
	                            </ul>
                            </div>

                            <h2>Definition</h2>
                            
                            @if (Item.MimeTypes.Any(m => m.EndsWith("/xml") || m.EndsWith("+xml")))
                            {
                                <div class="codeHeader">
                                    <span class="language">XML Schema</span>
                                    <button type="button" class="action position-relative display-none-print" onclick="copyCodeBlock(event)">
                                        <span class="icon margin-right-xxs" aria-hidden="true">
                                            <span class="docon docon-edit-copy"></span>
                                        </span>
                                        <span>Copy</span>
                                        <div class="successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent" aria-hidden="true">
                                            <span class="icon font-size-lg">
                                                <span class="docon docon-check-mark"></span>
                                            </span>
                                        </div>
                                    </button>
                                </div>
                                <pre class="wrap has-inner-focus"><code class="xml language-xml" dir="ltr">@Item.SchemaDefinition.ToXmlSchemaText(Item.Name)</code></pre>
                            }

                            @if (Item.MimeTypes.Any(m => m.EndsWith("/json") || m.EndsWith("+json")))
                            {
                                <div class="codeHeader">
                                    <span class="language">JSON Schema</span>
                                    <button type="button" class="action position-relative display-none-print" onclick="copyCodeBlock(event)">
                                        <span class="icon margin-right-xxs" aria-hidden="true">
                                            <span class="docon docon-edit-copy"></span>
                                        </span>
                                        <span>Copy</span>
                                        <div class="successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent" aria-hidden="true">
                                            <span class="icon font-size-lg">
                                                <span class="docon docon-check-mark"></span>
                                            </span>
                                        </div>
                                    </button>
                                </div>
                                <pre class="wrap has-inner-focus"><code class="json language-json" dir="ltr">@Item.SchemaDefinition.ToJsonSchemaText()</code></pre>

                                Dictionary<string, string> schemaReferenceUrls = new Dictionary<string, string>();
                                GetSchemaReferenceUrls(Item.SchemaDefinition, schemaReferenceUrls);

                                if (schemaReferenceUrls.Count > 0)
                                {
                                    <script type="text/javascript">
                                        window.schemaReferenceUrls = {};

                                        @foreach (KeyValuePair<string, string> schemaReferenceUrl in schemaReferenceUrls)
                                        {
                                            @Raw($@"window.schemaReferenceUrls[""{schemaReferenceUrl.Key}""] = ""{schemaReferenceUrl.Value}"";");
                                        }
                                    </script>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>

@code {
    private void GetSchemaReferenceUrls(Microsoft.OpenApi.IOpenApiSchema schema, Dictionary<string, string> urls)
    {
        if (schema == null)
        {
            return;
        }

        if (schema.Type == Microsoft.OpenApi.JsonSchemaType.Array && schema.Items != null)
        {
            GetSchemaReferenceUrls(schema.Items, urls);
        }

        else if (schema is Microsoft.OpenApi.OpenApiSchemaReference schemaReference && !String.IsNullOrEmpty(schemaReference.Reference.Id))
        {
            string schemaName = schemaReference.Reference.Id;
            InsightDocs.OpenApi.Model.OpenApiSchema? targetSchema = Item!.AllSchemas.FirstOrDefault(s => s.Name == schemaName);

            if (targetSchema == null)
            {
                throw new Exception("Schema not found: " + schemaName);
            }

            string url = OpenApiSchemaUrlProvider.GetUrl(targetSchema);

            urls[schemaReference.Reference.ReferenceV3!] = url;
        }

        else
        {
            if (schema.Properties == null)
            {
                return;
            }

            foreach (KeyValuePair<string, Microsoft.OpenApi.IOpenApiSchema> property in schema.Properties)
            {
                GetSchemaReferenceUrls(property.Value, urls);
            }
        }
    }
}