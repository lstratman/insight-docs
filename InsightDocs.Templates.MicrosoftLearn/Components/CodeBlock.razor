@Raw("<div class=\"codeHeader\"" + (LanguageId == "csharp" || LanguageId == "typescript" || AutoShow ? "" : " hidden") + ">")
    <span class="language">@LanguageLabel</span>
    <button type="button" class="action position-relative display-none-print" onclick="copyCodeBlock(event)">
        <span class="icon margin-right-xxs" aria-hidden="true">
            <span class="docon docon-edit-copy"></span>
        </span>
        <span>Copy</span>
        <div class="successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent" aria-hidden="true">
            <span class="icon font-size-lg">
                <span class="docon docon-check-mark"></span>
            </span>
        </div>
    </button>
@Raw("</div>")
@Raw("<pre class=\"wrap has-inner-focus\"" + (LanguageId == "csharp" || LanguageId == "typescript" || AutoShow ? "" : " hidden") + ">")<code class="@LanguageId language-@LanguageId" dir="ltr">@Code</code>@Raw("</pre>")

@code {
    public RenderFragment Raw(string html) => __builder =>
    {
        __builder.AddMarkupContent(0, html);
    };

    [Parameter]
    public string? LanguageLabel
    {
        get;
        set;
    }

    [Parameter]
    public string? LanguageId
    {
        get;
        set;
    }

    [Parameter]
    public string? Code
    {
        get;
        set;
    }

    [Parameter]
    public bool AutoShow
    {
        get;
        set;
    } = false;
}