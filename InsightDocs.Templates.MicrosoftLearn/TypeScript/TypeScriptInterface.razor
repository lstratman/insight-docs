@using InsightDocs.Templates.MicrosoftLearn.Components
@using InsightDocs.TypeScript.Model
@using InsightDocs.TypeScript.Model.Types
@inherits InsightDocs.TypeScript.RazorTypeScriptTemplate<InsightDocs.TypeScript.Model.TypeScriptInterface>
@inject InsightDocs.Abstractions.IPublisher Publisher

<html>
    <head>
        <link rel="stylesheet" href="@GetUrl(TemplateAssets.MicrosoftLearnCss)"/>

        @AddAdditionalCss()

        <script type="text/javascript" src="@GetUrl(TemplateAssets.HighlightJsScript)"></script>
        <script type="text/javascript" src="@GetUrl(TemplateAssets.CommonScript)"></script>

        @AddAdditionalJavaScript()

        <script type="text/javascript">hljs.highlightAll();</script>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    @if (Item!.ExportedFromModule == null && Item!.Namespace != null)
                    {
                        <div id="article-header" class="background-color-body margin-bottom-xs display-none-print">
			                <div class="display-flex align-items-center justify-content-space-between">
		                        <bread-crumbs id="article-header-breadcrumbs" class="overflow-hidden flex-grow-1 margin-right-sm margin-right-md-tablet margin-right-lg-desktop margin-left-negative-xxs padding-left-xxs" style="display: block; white-space: nowrap; overflow: hidden;">
			                        <nav>
				                        <ol class="breadcrumbs">
                                            <li class="breadcrumbs-item">
                                                @GetLink(Item.Namespace)
                                            </li>
				                        </ol>
			                        </nav>
                                </bread-crumbs>
			                </div>
		                </div>
                    }

                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.Title</h1>

                            <div class="margin-block-xxs">
	                            <ul class="metadata page-metadata align-items-center">
		                            <li>Reference</li>
	                            </ul>
                            </div>

                            <h2 id="definition">Definition</h2>

                            <div class="metadata">
                                @if (Item.Namespace != null)
                                {
                                    <dl class="attributeList">
                                        <dt>Namespace:</dt>
                                        <dd>@GetLink(Item.Namespace)</dd>
                                    </dl>
                                }
                            </div>

                            @if (!String.IsNullOrEmpty(Item.Comment?.SummaryHtml))
                            {
                                <div class="summaryHolder">
                                    <div class="summary clearFix has-text-wrap">
                                        @Raw(Item.Comment.SummaryHtml)
                                    </div>
                                </div>
                            }

                            <CodeBlock LanguageId="typescript" LanguageLabel="TypeScript" Code="@Item.ToString()"/>

                            @if (Item.TypeParameters != null && Item.TypeParameters.Count > 0)
                            {
                                <h4 class="propertyInfoTitle stack">Type Parameters</h4>

                                @foreach (TypeParameter typeParameter in Item.TypeParameters)
                                {
                                    <div class="propertyInfo">
                                        <dl class="parameterList">
                                            <dt>
                                                @typeParameter.Name
                                            </dt>
                                            <dd></dd>
                                        </dl>
                                    </div>
                                }
                            }

                            @if (Item.Extends != null)
                            {
                                <dl class="attributeList stack">
                                    <dt>Extends</dt>
                                    <dd>
                                        <div class="cdlHolder">
                                            @for (int i = 0; i < Item.Extends.Count; i++)
                                            {
                                                <span class="@(i == Item.Extends.Count - 1 ? "cdl cdlLastVisible" : "cdl")">
                                                    <span class="break-text">
                                                        @if (Item.Extends[i] is ReferenceType referenceType)
                                                        {
                                                            @GetLink(ReferenceType.AllTypes[referenceType.Target])
                                                        }

                                                        else
                                                        {
                                                            @Item.Extends[i].ToString()
                                                        }
                                                    </span>
                                                </span>
                                            }
                                        </div>
                                    </dd>
                                </dl>
                            }

                            <!-- TODO: support example JSDoc tags -->

                            <div data-no-chunk>
                                @if (Item.Constructor != null && Item.Constructor.Signatures.Any())
                                {
                                    Publisher.RegisterPublishedAnchor(Url, "constructors");

                                    <h2 id="constructors">Constructors</h2>

                                    <div class="has-inner-focus">
                                        <table class="table table-sm margin-top-none" aria-label="Methods">
        	                                <tbody>
                                                @foreach (TypeScriptMethodSignature methodOverload in Item.Constructor.Signatures.OrderBy(m => m.Parameters == null ? 0 : m.Parameters.Count).ThenBy(m => m.MemberDisplayName))
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="break-text">@GetLink(methodOverload)</span>
                                                        </td>
                                                        <td>
                                                            @if (!String.IsNullOrEmpty(methodOverload.Comment?.SummaryHtml))
                                                            {
                                                                @Raw(methodOverload.Comment.SummaryHtml)
                                                            }

                                                            @if (methodOverload.SourceTypeId != 0 && methodOverload.SourceTypeId != Item.Id)
                                                            {
                                                                <div>(Inherited from @GetLink(ReferenceType.AllTypes[methodOverload.SourceTypeId]))</div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @if (Item.Properties != null && Item.Properties.Any())
                                {
                                    Publisher.RegisterPublishedAnchor(Url, "properties");

                                    <h2 id="properties">Properties</h2>

                                    <div class="has-inner-focus">
                                        <table class="table table-sm margin-top-none" aria-label="Properties">
        	                                <tbody>
                                                @foreach (InsightDocs.TypeScript.Model.TypeScriptProperty property in Item.Properties.OrderBy(p => p.Name))
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="break-text">@GetLink(property, true)</span>
                                                        </td>
                                                        <td>
                                                            @if (!String.IsNullOrEmpty(property.Comment?.SummaryHtml))
                                                            {
                                                                @Raw(property.Comment.SummaryHtml)
                                                            }

                                                            @if (property.SourceTypeId != 0 && property.SourceTypeId != Item.Id)
                                                            {
                                                                <div>(Inherited from @GetLink(ReferenceType.AllTypes[property.SourceTypeId]))</div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @if (Item.Methods != null && Item.Methods.Any(m => m.Value.Signatures != null && m.Value.Signatures.Any()))
                                {
                                    Publisher.RegisterPublishedAnchor(Url, "methods");

                                    <h2 id="methods">Methods</h2>

                                    <div class="has-inner-focus">
                                        <table class="table table-sm margin-top-none" aria-label="Methods">
        	                                <tbody>
                                                @foreach (KeyValuePair<string, InsightDocs.TypeScript.Model.TypeScriptMethod> method in Item.Methods.OrderBy(m => m.Key))
                                                {
                                                    @foreach (TypeScriptMethodSignature methodOverload in method.Value.Signatures.OrderBy(m => m.Parameters == null ? 0 : m.Parameters.Count).ThenBy(m => m.MemberDisplayName))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="break-text">@GetLink(methodOverload)</span>
                                                            </td>
                                                            <td>
                                                                @if (!String.IsNullOrEmpty(methodOverload.Comment?.SummaryHtml))
                                                                {
                                                                    @Raw(methodOverload.Comment.SummaryHtml)
                                                                }

                                                                @if (methodOverload.SourceTypeId != 0 && methodOverload.SourceTypeId != Item.Id)
                                                                {
                                                                    <div>(Inherited from @GetLink(ReferenceType.AllTypes[methodOverload.SourceTypeId]))</div>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>