<div id="article-header-page-actions" class="margin-left-auto display-flex flex-wrap-no-wrap align-items-stretch">
	<div class="language dropdown display-flex align-items-center">
		<button type="button" class="dropdown-trigger button button-clear button-sm button-primary" aria-expanded="false" title="Language" data-bi-name="language" onclick="toggleLanguageMenu(event)">
			<span class="lang-title align-self-flex-start" dir="ltr">C#</span>
			<span class="icon" aria-hidden="true">
				<span class="docon docon-chevron-down-light expanded-indicator"></span>
			</span>
		</button>
		<div class="language-selector dropdown-menu padding-xxs">
			<ul data-bi-name="language-links" dir="ltr">
				<li>
					<button type="button" class="button button-clear button-sm button-block justify-content-flex-start" data-bi-name="lang-csharp" aria-pressed="true" onclick="setCurrentLanguage(event)">C#</button>
				</li>
				<li>
					<button type="button" class="button button-clear button-sm button-block justify-content-flex-start" data-bi-name="lang-vb" aria-pressed="false" onclick="setCurrentLanguage(event)">VB</button>
				</li>
			</ul>
		</div>
	</div>
</div>