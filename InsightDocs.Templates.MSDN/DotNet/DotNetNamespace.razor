@inherits InsightDocs.DotNet.RazorDotNetTemplate<InsightDocs.DotNet.Model.DotNetNamespace>

<html>
    <head>
        <link rel="stylesheet" href="@GetUrl(TemplateAssets.MsdnCss)"/>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div id="article-header" class="background-color-body margin-bottom-xs display-none-print">
			            <div class="display-flex align-items-center justify-content-space-between">
		                    <bread-crumbs id="article-header-breadcrumbs" class="overflow-hidden flex-grow-1 margin-right-sm margin-right-md-tablet margin-right-lg-desktop margin-left-negative-xxs padding-left-xxs" style="display: block; white-space: nowrap; overflow: hidden;">
			                    <nav>
				                    <ol class="breadcrumbs">
								        <li class="breadcrumbs-item">@GetLink(Item!.Index)</li>
				                    </ol>
			                    </nav>
                            </bread-crumbs>
			            </div>
		            </div>

                    <div class="content">
                        <h1>@Item!.FullName Namespace</h1>

                        @if (Item.Types.Any(t => t.TypeName == "Class"))
                        {
                            <div class="heading-wrapper" data-heading-level="h2">
                                <h2 class="heading-anchor">Classes</h2>
                            </div>

                            <div class="has-inner-focus">
                                <table class="table table-sm margin-top-none">
                                    <tbody>
                                        @foreach (InsightDocs.DotNet.Model.DotNetType type in Item.Types.Where(t => t.TypeName == "Class").OrderBy(t => t.Name))
                                        {
                                            <tr>
                                                <td><span class="break-text">@GetLink(type)</span></td>
                                                <td>
                                                    @if (type.Description != null)
                                                    {
                                                        @Raw(type.Description.ToHtml())
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (Item.Types.Any(t => t.TypeName == "Struct"))
                        {
                            <div class="heading-wrapper" data-heading-level="h2">
                                <h2 class="heading-anchor">Structs</h2>
                            </div>

                            <div class="has-inner-focus">
                                <table class="table table-sm margin-top-none">
                                    <tbody>
                                        @foreach (InsightDocs.DotNet.Model.DotNetType type in Item.Types.Where(t => t.TypeName == "Struct").OrderBy(t => t.Name))
                                        {
                                            <tr>
                                                <td><span class="break-text">@GetLink(type)</span></td>
                                                <td>
                                                    @if (type.Description != null)
                                                    {
                                                        @Raw(type.Description.ToHtml())
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (Item.Types.Any(t => t.TypeName == "Interface"))
                        {
                            <div class="heading-wrapper" data-heading-level="h2">
                                <h2 class="heading-anchor">Interfaces</h2>
                            </div>

                            <div class="has-inner-focus">
                                <table class="table table-sm margin-top-none">
                                    <tbody>
                                        @foreach (InsightDocs.DotNet.Model.DotNetType type in Item.Types.Where(t => t.TypeName == "Interface").OrderBy(t => t.Name))
                                        {
                                            <tr>
                                                <td><span class="break-text">@GetLink(type)</span></td>
                                                <td>
                                                    @if (type.Description != null)
                                                    {
                                                        @Raw(type.Description.ToHtml())
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (Item.Types.Any(t => t.TypeName == "Enum"))
                        {
                            <div class="heading-wrapper" data-heading-level="h2">
                                <h2 class="heading-anchor">Enums</h2>
                            </div>

                            <div class="has-inner-focus">
                                <table class="table table-sm margin-top-none">
                                    <tbody>
                                        @foreach (InsightDocs.DotNet.Model.DotNetType type in Item.Types.Where(t => t.TypeName == "Enum").OrderBy(t => t.Name))
                                        {
                                            <tr>
                                                <td><span class="break-text">@GetLink(type)</span></td>
                                                <td>
                                                    @if (type.Description != null)
                                                    {
                                                        @Raw(type.Description.ToHtml())
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>