@inherits InsightDocs.DotNet.RazorDotNetTemplate<InsightDocs.DotNet.Model.DotNetIndex>

<html>
    <head>
        <link rel="stylesheet" href="@GetUrl(TemplateAssets.MsdnCss)"/>

        @AddAdditionalCss()
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">					
			<div data-main-column="" class="padding-sm padding-top-l">
				<div class="content">
					<div class="padding-top-md">
                        <h1>@Item!.Title</h1>

                        <table class="table api-search-results">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (InsightDocs.DotNet.Model.DotNetNamespace ns in Item.Namespaces)
                                {
                                    <tr>
                                        <td>@GetLink(ns) Namespace</td>
                                        <td></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>