@inherits InsightDocs.DotNet.RazorDotNetTemplate<InsightDocs.DotNet.Model.DotNetProperty>

<html>
    <head>
        <link rel="stylesheet" href="../../msdn.css"/>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.Title</h1>

                            <h2>Definition</h2>

                            <div class="metadata">
                                @if (Item.DeclaringType?.Namespace != null)
                                {
                                    <dl class="attributeList">
                                        <dt>Namespace:</dt>
                                        <dd>@GetLink(Item.DeclaringType.Namespace)</dd>
                                    </dl>
                                }

                                @if (!String.IsNullOrEmpty(Item.DeclaringType?.Assembly?.Name))
                                {
                                    <dl class="attributeList">
                                        <dt>Assembly:</dt>
                                        <dd>@Item.DeclaringType.Assembly.Name</dd>
                                    </dl>
                                }
                            </div>

                            <div>
                                @if (Item.Description != null)
                                {
                                    <div class="summaryHolder">@Raw(Item.Description.ToHtml())</div>
                                }

                                <!-- TODO: code -->

                                <div class="heading-wrapper" data-heading-level="h4">
                                    <h4 class="propertyInfoTitle stack heading-anchor" id="property-value">Property Value</h4>
                                </div>

                                <div class="propertyInfo">@GetLink(Item.PropertyType)</div>

                                @if (Item.ValueDescription != null)
                                {
                                    @Raw(Item.ValueDescription.ToHtml(), "p")
                                }

                                @if (Item.Remarks != null)
                                {
                                    <div class="heading-wrapper" data-heading-level="h2">
                                        <h2 id="remarks" class="heading-anchor">Remarks</h2>
                                    </div>

                                    @Raw(Item.Remarks.ToHtml(), "p")
                                }

                                @if (Item.SeeAlso != null)
                                {
                                    <div class="heading-wrapper" data-heading-level="h2">
                                        <h2 class="propertyInfoTitle stack heading-anchor" id="see-also">See Also</h2>
                                    </div>

                                    <ul>
                                        @foreach (InsightDocs.DotNet.Model.XmlDocHtml seeAlso in Item.SeeAlso)
                                        {
                                            <li>@Raw(seeAlso.ToHtml())</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>