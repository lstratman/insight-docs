@inherits InsightDocs.DotNet.RazorDotNetTemplate<InsightDocs.DotNet.Model.DotNetProperty>

<html>
    <head>
        <link rel="stylesheet" href="@GetUrl(TemplateAssets.MsdnCss)"/>

        @AddAdditionalCss()

        <script type="text/javascript" src="@GetUrl(TemplateAssets.HighlightJsScript)"></script>
        <script type="text/javascript">hljs.highlightAll();</script>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div id="article-header" class="background-color-body margin-bottom-xs display-none-print">
			            <div class="display-flex align-items-center justify-content-space-between">
		                    <bread-crumbs id="article-header-breadcrumbs" class="overflow-hidden flex-grow-1 margin-right-sm margin-right-md-tablet margin-right-lg-desktop margin-left-negative-xxs padding-left-xxs" style="display: block; white-space: nowrap; overflow: hidden;">
			                    <nav>
				                    <ol class="breadcrumbs">
								        <li class="breadcrumbs-item">@GetLink(Item!.DeclaringType!.Type!.Index)</li>

                                        @if (Item.DeclaringType.Type.Namespace != null)
                                        {
                                            <li class="breadcrumbs-item">
                                                @GetLink(Item.DeclaringType.Type.Namespace)
                                            </li>

                                            <li class="breadcrumbs-item">
                                                @GetLink(Item.DeclaringType.Type)
                                            </li>
                                        }
				                    </ol>
			                    </nav>
                            </bread-crumbs>
			            </div>
		            </div>

                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.Title</h1>

                            <div class="margin-block-xxs">
	                            <ul class="metadata page-metadata align-items-center">
		                            <li>Reference</li>
	                            </ul>
                            </div>

                            <h2>Definition</h2>

                            <div class="metadata">
                                @if (Item.DeclaringType?.Namespace != null)
                                {
                                    <dl class="attributeList">
                                        <dt>Namespace:</dt>
                                        <dd>@GetLink(Item.DeclaringType.Namespace)</dd>
                                    </dl>
                                }

                                @if (!String.IsNullOrEmpty(Item.DeclaringType?.Assembly?.Name))
                                {
                                    <dl class="attributeList">
                                        <dt>Assembly:</dt>
                                        <dd>@Item.DeclaringType.Assembly.Name</dd>
                                    </dl>
                                }
                            </div>

                            <div>
                                @if (Item.Description != null)
                                {
                                    <div class="summaryHolder">@Raw(Item.Description.ToHtml())</div>
                                }

                                <div class="codeHeader">
                                    <span class="language">C#</span>
		                            <button type="button" class="action position-relative display-none-print">
			                            <span class="icon margin-right-xxs" aria-hidden="true">
				                            <span class="docon docon-edit-copy"></span>
			                            </span>
			                            <span>Copy</span>
			                            <div class="successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent" aria-hidden="true">
				                            <span class="icon font-size-lg">
					                            <span class="docon docon-check-mark"></span>
				                            </span>
			                            </div>
		                            </button>
	                            </div>
                                <pre class="wrap has-inner-focus"><code class="csharp language-csharp" dir="ltr">@Item.CSharpCode</code></pre>

                                <div class="heading-wrapper" data-heading-level="h4">
                                    <a class="anchor-link docon docon-link" href="#property-value"></a>
                                    <h4 class="propertyInfoTitle stack heading-anchor" id="property-value">Property Value</h4>
                                </div>

                                <div class="propertyInfo">@GetLink(Item.PropertyType)</div>

                                @if (Item.ValueDescription != null)
                                {
                                    @Raw(Item.ValueDescription.ToHtml(), "p")
                                }

                                @if (Item.Examples != null)
                                {
                                    <div class="heading-wrapper" data-heading-level="h2">
                                        <a class="anchor-link docon docon-link" href="#examples"></a>
                                        <h2 id="examples" class="heading-anchor">Examples</h2>
                                    </div>

                                    @foreach (Tuple<string, InsightDocs.DotNet.Model.XmlDocHtml> example in Item.Examples)
                                    {
                                        if (!String.IsNullOrEmpty(example.Item1))
                                        {
                                            <p>@Raw(example.Item1)</p>
                                        }

                                        <div class="codeHeader">
                                            <span class="language"></span>
		                                    <button type="button" class="action position-relative display-none-print">
			                                    <span class="icon margin-right-xxs" aria-hidden="true">
				                                    <span class="docon docon-edit-copy"></span>
			                                    </span>
			                                    <span>Copy</span>
			                                    <div class="successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent" aria-hidden="true">
				                                    <span class="icon font-size-lg">
					                                    <span class="docon docon-check-mark"></span>
				                                    </span>
			                                    </div>
		                                    </button>
	                                    </div>
                                        @Raw(example.Item2.ToHtml())
                                    }
                                }

                                @if (Item.Remarks != null)
                                {
                                    <div class="heading-wrapper" data-heading-level="h2">
                                        <a class="anchor-link docon docon-link" href="#remarks"></a>
                                        <h2 id="remarks" class="heading-anchor">Remarks</h2>
                                    </div>

                                    @Raw(Item.Remarks.ToHtml(), "p")
                                }

                                @if (Item.SeeAlso != null)
                                {
                                    <div class="heading-wrapper" data-heading-level="h2">
                                        <a class="anchor-link docon docon-link" href="#see-also"></a>
                                        <h2 class="propertyInfoTitle stack heading-anchor" id="see-also">See Also</h2>
                                    </div>

                                    <ul>
                                        @foreach (InsightDocs.DotNet.Model.XmlDocHtml seeAlso in Item.SeeAlso)
                                        {
                                            <li>@Raw(seeAlso.ToHtml())</li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>