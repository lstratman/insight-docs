@inherits InsightDocs.DotNet.RazorDotNetTemplate<InsightDocs.DotNet.Model.DotNetType>

<html>
    <head>
        <link rel="stylesheet" href="@GetUrl(TemplateAssets.MsdnCss)"/>

        @AddAdditionalCss()

        <script type="text/javascript" src="@GetUrl(TemplateAssets.HighlightJsScript)"></script>
        <script type="text/javascript">hljs.highlightAll();</script>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div id="article-header" class="background-color-body margin-bottom-xs display-none-print">
			            <div class="display-flex align-items-center justify-content-space-between">
		                    <bread-crumbs id="article-header-breadcrumbs" class="overflow-hidden flex-grow-1 margin-right-sm margin-right-md-tablet margin-right-lg-desktop margin-left-negative-xxs padding-left-xxs" style="display: block; white-space: nowrap; overflow: hidden;">
			                    <nav>
				                    <ol class="breadcrumbs">
								        <li class="breadcrumbs-item">@GetLink(Item!.Index)</li>

                                        @if (Item.Namespace != null)
                                        {
                                            <li class="breadcrumbs-item">
                                                @GetLink(Item.Namespace)
                                            </li>
                                        }
				                    </ol>
			                    </nav>
                            </bread-crumbs>
			            </div>
		            </div>

                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.Title</h1>

                            <div class="margin-block-xxs">
	                            <ul class="metadata page-metadata align-items-center">
		                            <li>Reference</li>
	                            </ul>
                            </div>

                            <h2 id="definition">Definition</h2>

                            <div class="metadata">
                                @if (Item.Namespace != null)
                                {
                                    <dl class="attributeList">
                                        <dt>Namespace:</dt>
                                        <dd>@GetLink(Item.Namespace)</dd>
                                    </dl>
                                }

                                @if (!String.IsNullOrEmpty(Item.Assembly?.Name))
                                {
                                    <dl class="attributeList">
                                        <dt>Assembly:</dt>
                                        <dd>@Item.Assembly.Name</dd>
                                    </dl>
                                }
                            </div>

                            @if (Item.Description != null)
                            {
                                <div class="summaryHolder">
                                    <div class="summary clearFix has-text-wrap">
                                        @Raw(Item.Description.ToHtml())
                                    </div>
                                </div>
                            }

                            <div class="codeHeader">
                                <span class="language">C#</span>
		                        <button type="button" class="action position-relative display-none-print">
			                        <span class="icon margin-right-xxs" aria-hidden="true">
				                        <span class="docon docon-edit-copy"></span>
			                        </span>
			                        <span>Copy</span>
			                        <div class="successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent" aria-hidden="true">
				                        <span class="icon font-size-lg">
					                        <span class="docon docon-check-mark"></span>
				                        </span>
			                        </div>
		                        </button>
	                        </div>
                            <pre class="wrap has-inner-focus"><code class="csharp language-csharp" dir="ltr">@Item.CSharpCode</code></pre>

                            @if (Item.TypeParameters != null && Item.TypeParameters.Count > 0)
                            {
                                <h4 class="propertyInfoTitle stack">Type Parameters</h4>

                                @foreach (InsightDocs.DotNet.Model.DotNetTypeParameter typeParameter in Item.TypeParameters)
                                {
                                    <div class="propertyInfo">
                                        <dl class="parameterList">
                                            <dt>
                                                @typeParameter.Name
                                            </dt>
                                            <dd></dd>
                                        </dl>
                                    </div>

                                    @if (typeParameter.Description != null)
                                    {
                                        @Raw(typeParameter.Description.ToHtml(), "p")
                                    }
                                }
                            }

                            @if (Item.BaseType != null)
                            {
                                List<InsightDocs.DotNet.Model.DotNetTypeReference> baseTypes = [];
                                InsightDocs.DotNet.Model.DotNetTypeReference? currentBaseType = Item.BaseType;

                                while (currentBaseType != null)
                                {
                                    baseTypes.Add(currentBaseType);
                                    currentBaseType = currentBaseType.Type?.BaseType;
                                }
                                
                                baseTypes.Reverse();

                                <dl class="attributeList stack">
                                    <dt>Inheritance</dt>
                                    <dd>
                                        <div class="pdlHolder">
                                            @foreach (InsightDocs.DotNet.Model.DotNetTypeReference baseType in baseTypes)
                                            {
                                                <div class="pdl">@GetLink(baseType)</div> 
                                            }
                                            <span>@Item.DisplayName</span> 
                                        </div>
                                    </dd>
                                </dl>
                            }

                            @if (Item.ImplementedInterfaces != null)
                            {
                                <dl class="attributeList stack">
                                    <dt>Implements</dt>
                                    <dd>
                                        <div class="cdlHolder">
                                            @for (int i = 0; i < Item.ImplementedInterfaces.Count; i++)
                                            {
                                                <span class="@(i == Item.ImplementedInterfaces.Count - 1 ? "cdl cdlLastVisible" : "cdl")">
                                                    <span class="break-text">@GetLink(Item.ImplementedInterfaces[i])</span>
                                                </span>
                                            }
                                        </div>
                                    </dd>
                                </dl>
                            }

                            @if (Item.TypeName == "Enum" && Item.Fields != null)
                            {
                                <h2 id="properties">Fields</h2>

                                <div class="has-inner-focus">
                                    <table class="table table-sm margin-top-none" aria-label="Fields">
        	                            <tbody>
                                            <tr>
			                                    <th>Name</th>
			                                    <th>Value</th>
			                                    <th>Description</th>
		                                    </tr>

                                            @foreach (InsightDocs.DotNet.Model.DotNetField field in Item.Fields.Where(f => f.Name != "value__").OrderBy(f => f.Name))
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="break-text">@field.Name</span>
                                                    </td>
                                                    <td>
                                                        @if (field.ConstantValue != null)
                                                        {
                                                            @field.ConstantValue.ToString()
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (field.Description != null)
                                                        {
                                                            <p>@Raw(field.Description.ToHtml())</p>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (Item.Examples != null)
                            {
                                <div class="heading-wrapper" data-heading-level="h2">
                                    <h2 id="examples" class="heading-anchor">Examples</h2>
                                </div>

                                @foreach (Tuple<string, InsightDocs.DotNet.Model.XmlDocHtml> example in Item.Examples)
                                {
                                    if (!String.IsNullOrEmpty(example.Item1))
                                    {
                                        <p>@Raw(example.Item1)</p>
                                    }

                                    <div class="codeHeader">
                                        <span class="language"></span>
		                                <button type="button" class="action position-relative display-none-print">
			                                <span class="icon margin-right-xxs" aria-hidden="true">
				                                <span class="docon docon-edit-copy"></span>
			                                </span>
			                                <span>Copy</span>
			                                <div class="successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent" aria-hidden="true">
				                                <span class="icon font-size-lg">
					                                <span class="docon docon-check-mark"></span>
				                                </span>
			                                </div>
		                                </button>
	                                </div>
                                    @Raw(example.Item2.ToHtml())
                                }
                            }

                            @if (Item.Remarks != null)
                            {
                                <div class="heading-wrapper" data-heading-level="h2">
                                    <a class="anchor-link docon docon-link" href="#remarks"></a>
                                    <h2 id="remarks" class="heading-anchor">Remarks</h2>
                                </div>

                                @Raw(Item.Remarks.ToHtml(), "p")
                            }

                            @if (Item.SeeAlso != null)
                            {
                                <div class="heading-wrapper" data-heading-level="h2">
                                    <a class="anchor-link docon docon-link" href="#see-also"></a>
                                    <h2 class="propertyInfoTitle stack heading-anchor" id="see-also">See Also</h2>
                                </div>

                                <ul>
                                    @foreach (InsightDocs.DotNet.Model.XmlDocHtml seeAlso in Item.SeeAlso)
                                    {
                                        <li>@Raw(seeAlso.ToHtml())</li>
                                    }
                                </ul>
                            }

                            @if (Item.TypeName != "Enum")
                            {
                                <div data-no-chunk>
                                    @if (Item.Constructor != null && Item.Constructor.Overloads.Any())
                                    {
                                        <h2 id="methods">Constructors</h2>

                                        <div class="has-inner-focus">
                                            <table class="table table-sm margin-top-none" aria-label="Methods">
        	                                    <tbody>
                                                    @foreach (InsightDocs.DotNet.Model.DotNetMethodOverload methodOverload in Item.Constructor.Overloads.OrderBy(m => m.Parameters == null ? 0 : m.Parameters.Count).ThenBy(m => m.MemberDisplayName))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="break-text">@GetLink(methodOverload)</span>
                                                            </td>
                                                            <td>
                                                                @if (methodOverload.Description != null)
                                                                {
                                                                    <p>@Raw(methodOverload.Description.ToHtml())</p>
                                                                }

                                                                @if (methodOverload.DeclaringType != null && methodOverload.DeclaringType.Type != Item)
                                                                {
                                                                    <div>(Inherited from @GetLink(methodOverload.DeclaringType))</div>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    @if (Item.Indexer != null)
                                    {
                                        <h2 id="properties">Indexers</h2>

                                        <div class="has-inner-focus">
                                            <table class="table table-sm margin-top-none" aria-label="Fields">
        	                                    <tbody>
                                                    @foreach (InsightDocs.DotNet.Model.DotNetProperty indexerOverload in Item.Indexer.Overloads.OrderBy(f => f.MemberDisplayName))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="break-text">@GetLink(indexerOverload)</span>
                                                            </td>
                                                            <td>
                                                                @if (indexerOverload.Description != null)
                                                                {
                                                                    <p>@Raw(indexerOverload.Description.ToHtml())</p>
                                                                }

                                                                @if (indexerOverload.DeclaringType != null && indexerOverload.DeclaringType.Type != Item)
                                                                {
                                                                    <div>(Inherited from @GetLink(indexerOverload.DeclaringType))</div>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    @if (Item.Fields != null && Item.Fields.Any())
                                    {
                                        <h2 id="properties">Fields</h2>

                                        <div class="has-inner-focus">
                                            <table class="table table-sm margin-top-none" aria-label="Fields">
        	                                    <tbody>
                                                    @foreach (InsightDocs.DotNet.Model.DotNetField field in Item.Fields.OrderBy(f => f.Name))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="break-text">@GetLink(field)</span>
                                                            </td>
                                                            <td>
                                                                @if (field.Description != null)
                                                                {
                                                                    <p>@Raw(field.Description.ToHtml())</p>
                                                                }

                                                                @if (field.DeclaringType != null && field.DeclaringType.Type != Item)
                                                                {
                                                                    <div>(Inherited from @GetLink(field.DeclaringType))</div>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    @if (Item.Properties != null && Item.Properties.Any())
                                    {
                                        <h2 id="properties">Properties</h2>

                                        <div class="has-inner-focus">
                                            <table class="table table-sm margin-top-none" aria-label="Properties">
        	                                    <tbody>
                                                    @foreach (InsightDocs.DotNet.Model.DotNetProperty property in Item.Properties.OrderBy(p => p.Name))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="break-text">@GetLink(property)</span>
                                                            </td>
                                                            <td>
                                                                @if (property.Description != null)
                                                                {
                                                                    <p>@Raw(property.Description.ToHtml())</p>
                                                                }

                                                                @if (property.DeclaringType != null && property.DeclaringType.Type != Item)
                                                                {
                                                                    <div>(Inherited from @GetLink(property.DeclaringType))</div>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    @if (Item.Methods != null && Item.Methods.Any())
                                    {
                                        <h2 id="methods">Methods</h2>

                                        <div class="has-inner-focus">
                                            <table class="table table-sm margin-top-none" aria-label="Methods">
        	                                    <tbody>
                                                    @foreach (InsightDocs.DotNet.Model.DotNetMethod method in Item.Methods.OrderBy(m => m.Name))
                                                    {
                                                        @foreach (InsightDocs.DotNet.Model.DotNetMethodOverload methodOverload in method.Overloads.OrderBy(m => m.Parameters == null ? 0 : m.Parameters.Count).ThenBy(m => m.MemberDisplayName))
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <span class="break-text">@GetLink(methodOverload)</span>
                                                                </td>
                                                                <td>
                                                                    @if (methodOverload.Description != null)
                                                                    {
                                                                        <p>@Raw(methodOverload.Description.ToHtml())</p>
                                                                    }

                                                                    @if (methodOverload.DeclaringType != null && methodOverload.DeclaringType.Type != Item)
                                                                    {
                                                                        <div>(Inherited from @GetLink(methodOverload.DeclaringType))</div>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <!-- TODO: explicit interface implementations -->

                                    <!-- TODO: operators -->
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>