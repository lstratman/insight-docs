<html>
    <head>
        <link rel="stylesheet" href="../../msdn.css"/>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.DisplayTitle</h1>

                            <h2 id="definition">Definition</h2>

                            <div class="metadata">
                                @if (Item.Namespace != null)
                                {
                                    <dl class="attributeList">
                                        <dt>Namespace:</dt>
                                        <dd>@RazorTemplate.GetLink(Item.Namespace, Item.Namespace.FullName, ServiceProvider!)</dd>
                                    </dl>
                                }

                                @if (!String.IsNullOrEmpty(Item.Assembly?.Name))
                                {
                                    <dl class="attributeList">
                                        <dt>Assembly:</dt>
                                        <dd>@Item.Assembly.Name</dd>
                                    </dl>
                                }
                            </div>

                            @if (Item.Description != null)
                            {
                                <div class="summaryHolder">
                                    <div class="summary clearFix has-text-wrap">
                                        @RazorTemplate.Raw(Item.Description.ToHtml())
                                    </div>
                                </div>
                            }

                            <!-- TODO: code -->

                            @if (Item.TypeParameters != null && Item.TypeParameters.Count > 0)
                            {
                                <h4 class="propertyInfoTitle stack">Type Parameters</h4>

                                @foreach (Model.DotNet.DotNetTypeParameter typeParameter in Item.TypeParameters)
                                {
                                    <div class="propertyInfo">
                                        <dl class="parameterList">
                                            <dt>
                                                @typeParameter.Name
                                            </dt>
                                            <dd>
                                                <!-- TODO: typeParameter constraints -->
                                            </dd>
                                        </dl>
                                    </div>

                                    @if (typeParameter.Description != null)
                                    {
                                        <p>@RazorTemplate.Raw(typeParameter.Description.ToHtml())</p>
                                    }
                                }
                            }

                            <!-- TODO: base classes -->

                            <!-- TODO: implemented interfaces -->

                            <!-- TODO: remarks -->

                            <div data-no-chunk>
                                <!-- TODO: constructors-->

                                @if (Item.Fields != null && Item.Fields.Any())
                                {
                                    <h2 id="properties">Fields</h2>

                                    <div class="has-inner-focus">
                                        <table class="table table-sm margin-top-none" aria-label="Fields">
        	                                <tbody>
                                                @foreach (Model.DotNet.DotNetField field in Item.Fields.OrderBy(f => f.Name))
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="break-text">@RazorTemplate.GetLink(field, field.Name, ServiceProvider!)</span>
                                                        </td>
                                                        <td>
                                                            @if (field.Description != null)
                                                            {
                                                                <p>@RazorTemplate.Raw(field.Description.ToHtml())</p>
                                                            }

                                                            @if (field.DeclaringType != null && field.DeclaringType.Type != Item)
                                                            {
                                                                <div>(Inherited from @RazorTemplate.GetLink(field.DeclaringType, field.DeclaringType.Name, ServiceProvider!))</div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @if (Item.Properties != null && Item.Properties.Any())
                                {
                                    <h2 id="properties">Properties</h2>

                                    <div class="has-inner-focus">
                                        <table class="table table-sm margin-top-none" aria-label="Properties">
        	                                <tbody>
                                                @foreach (Model.DotNet.DotNetProperty property in Item.Properties.OrderBy(p => p.Name))
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="break-text">@RazorTemplate.GetLink(property, property.Name, ServiceProvider!)</span>
                                                        </td>
                                                        <td>
                                                            @if (property.Description != null)
                                                            {
                                                                <p>@RazorTemplate.Raw(property.Description.ToHtml())</p>
                                                            }

                                                            @if (property.DeclaringType != null && property.DeclaringType.Type != Item)
                                                            {
                                                                <div>(Inherited from @RazorTemplate.GetLink(property.DeclaringType, property.DeclaringType.Name, ServiceProvider!))</div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @if (Item.Methods != null && Item.Methods.Any())
                                {
                                    <h2 id="methods">Methods</h2>

                                    <div class="has-inner-focus">
                                        <table class="table table-sm margin-top-none" aria-label="Methods">
        	                                <tbody>
                                                @foreach (Model.DotNet.DotNetMethod method in Item.Methods.OrderBy(m => m.Name).ThenBy(m => m.Parameters == null ? 0 : m.Parameters.Count).ThenBy(m => m.LinkTitle))
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="break-text">@RazorTemplate.GetLink(method, method.LinkTitle, ServiceProvider!)</span>
                                                        </td>
                                                        <td>
                                                            @if (method.Description != null)
                                                            {
                                                                <p>@RazorTemplate.Raw(method.Description.ToHtml())</p>
                                                            }

                                                            @if (method.DeclaringType != null && method.DeclaringType.Type != Item)
                                                            {
                                                                <div>(Inherited from @RazorTemplate.GetLink(method.DeclaringType, method.DeclaringType.Name, ServiceProvider!))</div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <!-- TODO: explicit interface implementations -->

                                <!-- TODO: operators -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>

@code {
    [Parameter]
    public Model.DotNet.DotNetType? Item 
    { 
        get; 
        set; 
    }

    [Parameter]
    public IServiceProvider? ServiceProvider
    { 
        get; 
        set; 
    }
}