<html>
    <head>
        <link rel="stylesheet" href="../../msdn.css"/>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.Title</h1>

                            <h2 id="definition">Definition</h2>

                            <div class="metadata">
                                @if (Item.Namespace != null)
                                {
                                    <dl class="attributeList">
                                        <dt>Namespace:</dt>
                                        <dd>@RazorTemplate.GetLink(Item.Namespace, ServiceProvider!)</dd>
                                    </dl>
                                }

                                @if (!String.IsNullOrEmpty(Item.Assembly?.Name))
                                {
                                    <dl class="attributeList">
                                        <dt>Assembly:</dt>
                                        <dd>@Item.Assembly.Name</dd>
                                    </dl>
                                }
                            </div>

                            @if (Item.Description != null)
                            {
                                <div class="summaryHolder">
                                    <div class="summary clearFix has-text-wrap">
                                        @RazorTemplate.Raw(Item.Description.ToHtml())
                                    </div>
                                </div>
                            }

                            <!-- TODO: code -->

                            @if (Item.TypeParameters != null && Item.TypeParameters.Count > 0)
                            {
                                <h4 class="propertyInfoTitle stack">Type Parameters</h4>

                                @foreach (InsightDocs.DotNet.Model.DotNetTypeParameter typeParameter in Item.TypeParameters)
                                {
                                    <div class="propertyInfo">
                                        <dl class="parameterList">
                                            <dt>
                                                @typeParameter.Name
                                            </dt>
                                            <dd>
                                                <!-- TODO: typeParameter constraints -->
                                            </dd>
                                        </dl>
                                    </div>

                                    @if (typeParameter.Description != null)
                                    {
                                        @RazorTemplate.Raw(typeParameter.Description.ToHtml(), "p")
                                    }
                                }
                            }

                            @if (Item.BaseType != null)
                            {
                                List<InsightDocs.DotNet.Model.DotNetTypeReference> baseTypes = [];
                                InsightDocs.DotNet.Model.DotNetTypeReference? currentBaseType = Item.BaseType;

                                while (currentBaseType != null)
                                {
                                    baseTypes.Add(currentBaseType);
                                    currentBaseType = currentBaseType.Type?.BaseType;
                                }
                                
                                baseTypes.Reverse();

                                <dl class="attributeList stack">
                                    <dt>Inheritance</dt>
                                    <dd>
                                        <div class="pdlHolder">
                                            @foreach (InsightDocs.DotNet.Model.DotNetTypeReference baseType in baseTypes)
                                            {
                                                <div class="pdl">@RazorTemplate.GetLink(baseType, ServiceProvider!)</div> 
                                            }
                                            <span>@Item.DisplayName</span> 
                                        </div>
                                    </dd>
                                </dl>
                            }

                            @if (Item.ImplementedInterfaces != null)
                            {
                                <dl class="attributeList stack">
                                    <dt>Implements</dt>
                                    <dd>
                                        <div class="cdlHolder">
                                            @for (int i = 0; i < Item.ImplementedInterfaces.Count; i++)
                                            {
                                                <span class="@(i == Item.ImplementedInterfaces.Count - 1 ? "cdl cdlLastVisible" : "cdl")">
                                                    <span class="break-text">@RazorTemplate.GetLink(Item.ImplementedInterfaces[i], ServiceProvider!)</span>
                                                </span>
                                            }
                                        </div>
                                    </dd>
                                </dl>
                            }

                            @if (Item.Remarks != null)
                            {
                                <div class="heading-wrapper" data-heading-level="h2">
                                    <h2 id="remarks" class="heading-anchor">Remarks</h2>
                                </div>

                                @RazorTemplate.Raw(Item.Remarks.ToHtml(), "p")
                            }

                            @if (Item.SeeAlso != null)
                            {
                                <div class="heading-wrapper" data-heading-level="h2">
                                    <h2 class="propertyInfoTitle stack heading-anchor" id="see-also">See Also</h2>
                                </div>

                                <ul>
                                    @foreach (InsightDocs.DotNet.Model.XmlDocHtml seeAlso in Item.SeeAlso)
                                    {
                                        <li>@RazorTemplate.Raw(seeAlso.ToHtml())</li>
                                    }
                                </ul>
                            }

                            <div data-no-chunk>
                                <!-- TODO: constructors-->

                                @if (Item.Fields != null && Item.Fields.Any())
                                {
                                    <h2 id="properties">Fields</h2>

                                    <div class="has-inner-focus">
                                        <table class="table table-sm margin-top-none" aria-label="Fields">
        	                                <tbody>
                                                @foreach (InsightDocs.DotNet.Model.DotNetField field in Item.Fields.OrderBy(f => f.Name))
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="break-text">@RazorTemplate.GetLink(field, ServiceProvider!)</span>
                                                        </td>
                                                        <td>
                                                            @if (field.Description != null)
                                                            {
                                                                <p>@RazorTemplate.Raw(field.Description.ToHtml())</p>
                                                            }

                                                            @if (field.DeclaringType != null && field.DeclaringType.Type != Item)
                                                            {
                                                                <div>(Inherited from @RazorTemplate.GetLink(field.DeclaringType, ServiceProvider!))</div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @if (Item.Properties != null && Item.Properties.Any())
                                {
                                    <h2 id="properties">Properties</h2>

                                    <div class="has-inner-focus">
                                        <table class="table table-sm margin-top-none" aria-label="Properties">
        	                                <tbody>
                                                @foreach (InsightDocs.DotNet.Model.DotNetProperty property in Item.Properties.OrderBy(p => p.Name))
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="break-text">@RazorTemplate.GetLink(property, ServiceProvider!)</span>
                                                        </td>
                                                        <td>
                                                            @if (property.Description != null)
                                                            {
                                                                <p>@RazorTemplate.Raw(property.Description.ToHtml())</p>
                                                            }

                                                            @if (property.DeclaringType != null && property.DeclaringType.Type != Item)
                                                            {
                                                                <div>(Inherited from @RazorTemplate.GetLink(property.DeclaringType, ServiceProvider!))</div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @if (Item.Methods != null && Item.Methods.Any())
                                {
                                    <h2 id="methods">Methods</h2>

                                    <div class="has-inner-focus">
                                        <table class="table table-sm margin-top-none" aria-label="Methods">
        	                                <tbody>
                                                @foreach (InsightDocs.DotNet.Model.DotNetMethod method in Item.Methods.OrderBy(m => m.Name))
                                                {
                                                    @foreach (InsightDocs.DotNet.Model.DotNetMethodOverload methodOverload in method.Overloads.OrderBy(m => m.Parameters == null ? 0 : m.Parameters.Count).ThenBy(m => m.MemberDisplayName))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="break-text">@RazorTemplate.GetLink(methodOverload, ServiceProvider!)</span>
                                                            </td>
                                                            <td>
                                                                @if (methodOverload.Description != null)
                                                                {
                                                                    <p>@RazorTemplate.Raw(methodOverload.Description.ToHtml())</p>
                                                                }

                                                                @if (methodOverload.DeclaringType != null && methodOverload.DeclaringType.Type != Item)
                                                                {
                                                                    <div>(Inherited from @RazorTemplate.GetLink(methodOverload.DeclaringType, ServiceProvider!))</div>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <!-- TODO: explicit interface implementations -->

                                <!-- TODO: operators -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>

@code {
    [Parameter]
    public InsightDocs.DotNet.Model.DotNetType? Item 
    { 
        get; 
        set; 
    }

    [Parameter]
    public IServiceProvider? ServiceProvider
    { 
        get; 
        set; 
    }
}