@inherits InsightDocs.DotNet.RazorDotNetTemplate<InsightDocs.DotNet.Model.DotNetMethod>
@using InsightDocs.Templates.MSDN.Components
@using Microsoft.Extensions.DependencyInjection

<html>
    <head>
        <link rel="stylesheet" href="@GetUrl(TemplateAssets.MsdnCss)"/>

        @AddAdditionalCss()

        <script type="text/javascript" src="@GetUrl(TemplateAssets.HighlightJsScript)"></script>
        <script type="text/javascript" src="@GetUrl(TemplateAssets.CommonScript)"></script>
        <script type="text/javascript" src="@GetUrl(TemplateAssets.DotNetScript)"></script>
        <script type="text/javascript">hljs.highlightAll();</script>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div id="article-header" class="background-color-body margin-bottom-xs display-none-print">
			            <div class="display-flex align-items-center justify-content-space-between">
		                    <bread-crumbs id="article-header-breadcrumbs" class="overflow-hidden flex-grow-1 margin-right-sm margin-right-md-tablet margin-right-lg-desktop margin-left-negative-xxs padding-left-xxs" style="display: block; white-space: nowrap; overflow: hidden;">
			                    <nav>
				                    <ol class="breadcrumbs">
								        <li class="breadcrumbs-item">@GetLink(Item!.DeclaringType!.Type!.Index)</li>

                                        @if (Item.DeclaringType.Type.Namespace != null)
                                        {
                                            <li class="breadcrumbs-item">
                                                @GetLink(Item.DeclaringType.Type.Namespace)
                                            </li>

                                            <li class="breadcrumbs-item">
                                                @GetLink(Item.DeclaringType.Type)
                                            </li>
                                        }
				                    </ol>
			                    </nav>
                            </bread-crumbs>
                            <LanguageDropdown/>
			            </div>
		            </div>

                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.Title</h1>

                            <div class="margin-block-xxs">
	                            <ul class="metadata page-metadata align-items-center">
		                            <li>Reference</li>
	                            </ul>
                            </div>

                            <h2>Definition</h2>

                            <div class="metadata">
                                @if (Item.DeclaringType?.Namespace != null)
                                {
                                    <dl class="attributeList">
                                        <dt>Namespace:</dt>
                                        <dd>@GetLink(Item.DeclaringType.Namespace)</dd>
                                    </dl>
                                }

                                @if (!String.IsNullOrEmpty(Item.DeclaringType?.Assembly?.Name))
                                {
                                    <dl class="attributeList">
                                        <dt>Assembly:</dt>
                                        <dd>@Item.DeclaringType.Assembly.Name</dd>
                                    </dl>
                                }
                            </div>

                            @if (Item.Overloads.Count(o => o.DeclaringType != null && Item.DeclaringType != null && o.DeclaringType.Type == Item.DeclaringType.Type) > 1)
                            {
                                <h2 id="overloads">Overloads</h2>
                            }

                            @{
                                bool reduceHeaderSize = Item.Overloads.Count(o => o.DeclaringType != null && Item.DeclaringType != null && o.DeclaringType.Type == Item.DeclaringType.Type) > 1;
                            }

                            @foreach (InsightDocs.DotNet.Model.DotNetMethodOverload overload in Item.Overloads.Where(o => o.DeclaringType != null && Item.DeclaringType != null && o.DeclaringType.Type == Item.DeclaringType.Type))
                            {
                                <div>
                                    @if (Item.Overloads.Count(o => o.DeclaringType != null && Item.DeclaringType != null && o.DeclaringType.Type == Item.DeclaringType.Type) > 1)
                                    {
                                        string overloadUrl = ServiceProvider!.GetRequiredService<InsightDocs.Abstractions.IUrlProvider<InsightDocs.DotNet.Model.DotNetMethodOverload>>().GetUrl(overload);

                                        <div class="heading-wrapper" data-heading-level="h3">
                                            @if (overloadUrl.IndexOf("#") != -1)
                                            {
                                                <a class="anchor-link docon docon-link" href="#@overloadUrl.Substring(overloadUrl.IndexOf("#") + 1)"></a>
                                                <h3 id="@overloadUrl.Substring(overloadUrl.IndexOf("#") + 1)" class="memberNameHolder heading-anchor">@overload.MemberDisplayName</h3>
                                            }

                                            else
                                            {
                                                <h3 class="memberNameHolder heading-anchor">@overload.MemberDisplayName</h3>
                                            }
                                        </div>

                                        @Raw("<div class=\"memberInfo\">")
                                    }

                                    @if (overload.Description != null)
                                    {
                                        <div class="summaryHolder">@Raw(overload.Description.ToHtml())</div>
                                    }

                                    <CodeBlock LanguageId="csharp" LanguageLabel="C#" Code="@overload.CSharpCode"/>
                                    <CodeBlock LanguageId="vb" LanguageLabel="VB" Code="@overload.VBCode"/>

                                    @if (overload.GenericArguments != null && overload.GenericArguments.Count > 0)
                                    {
                                        if (reduceHeaderSize)
                                        {
                                            <h4 class="propertyInfoTitle stack">Generic Arguments</h4>
                                        }

                                        else
                                        {
                                            <h3 class="propertyInfoTitle stack">Generic Arguments</h3>
                                        }

                                        @foreach (InsightDocs.DotNet.Model.DotNetTypeParameter genericArgument in overload.GenericArguments)
                                        {
                                            <div class="propertyInfo">
                                                <dl class="parameterList">
                                                    <dt>
                                                        @genericArgument.Name
                                                    </dt>
                                                    <dd></dd>
                                                </dl>
                                            </div>

                                            @if (genericArgument.Description != null)
                                            {
                                                @Raw(genericArgument.Description.ToHtml(), "p")
                                            }
                                        }
                                    }

                                    @if (overload.Parameters != null)
                                    {
                                        if (reduceHeaderSize)
                                        {
                                            <h4 class="propertyInfoTitle stack heading-anchor" id="parameters">Parameters</h4>
                                        }

                                        else
                                        {
                                            <h3 class="propertyInfoTitle stack heading-anchor" id="parameters">Parameters</h3>
                                        }

                                        @for (int i = 0; i < overload.Parameters.Count; i++)
                                        {
                                            <div class="@(i == 0 ? "propertyInfo" : "propertyInfo stack")">
                                                <dl class="parameterList">
                                                    <dt>@overload.Parameters[i].Name</dt>
                                                    <dd>@GetLink(overload.Parameters[i].Type)</dd>
                                                </dl>

                                                @if (overload.Parameters[i].Description != null)
                                                {
                                                    <p>@Raw(overload.Parameters[i].Description!.ToHtml())</p>
                                                }
                                            </div>
                                        }
                                    }

                                    @if (!overload.IsConstructor)
                                    {
                                        if (reduceHeaderSize)
                                        {
                                            <h4 class="propertyInfoTitle stack heading-anchor" id="returns">Returns</h4>
                                        }

                                        else
                                        {
                                            <h3 class="propertyInfoTitle stack heading-anchor" id="returns">Returns</h3>
                                        }

                                        <div class="propertyInfo">@GetLink(overload.ReturnType)</div>

                                        @if (overload.ReturnsDescription != null)
                                        {
                                            @Raw(overload.ReturnsDescription.ToHtml(), "p")
                                        }
                                    }

                                    @if (overload.Exceptions != null)
                                    {
                                        if (reduceHeaderSize)
                                        {
                                            <h4 class="propertyInfoTitle stack heading-anchor" id="exceptions">Exceptions</h4>
                                        }

                                        else
                                        {
                                            <h3 class="propertyInfoTitle stack heading-anchor" id="exceptions">Exceptions</h3>
                                        }

                                        for (int i = 0; i < overload.Exceptions.Count; i++)
                                        {
                                            Tuple<InsightDocs.DotNet.Model.XmlDocHtml, InsightDocs.DotNet.Model.XmlDocHtml?> exception = overload.Exceptions[i];

                                            <div class="@(i == 0 ? "propertyInfo" : "propertyInfo stack")">
                                                <div class="subtle">
                                                    @Raw(exception.Item1.ToHtml())
                                                </div>
                                                
                                                @if (exception.Item2 != null)
                                                {
                                                    @Raw(exception.Item2.ToHtml(), "p")
                                                }
                                            </div>
                                        }
                                    }

                                    @if (overload.Examples != null)
                                    {
                                        if (reduceHeaderSize)
                                        {
                                            <h4 id="examples" class="heading-anchor">Examples</h4>
                                        }

                                        else
                                        {
                                            <h3 id="examples" class="heading-anchor">Examples</h3>
                                        }

                                        @foreach (Tuple<string, InsightDocs.DotNet.Model.XmlDocHtml> example in overload.Examples)
                                        {
                                            if (!String.IsNullOrEmpty(example.Item1))
                                            {
                                                <p>@Raw(example.Item1)</p>
                                            }

                                            <div class="codeHeader">
                                                <span class="language"></span>
		                                        <button type="button" class="action position-relative display-none-print">
			                                        <span class="icon margin-right-xxs" aria-hidden="true">
				                                        <span class="docon docon-edit-copy"></span>
			                                        </span>
			                                        <span>Copy</span>
			                                        <div class="successful-copy-alert position-absolute right-0 top-0 left-0 bottom-0 display-flex align-items-center justify-content-center has-text-success-invert has-background-success is-transparent" aria-hidden="true">
				                                        <span class="icon font-size-lg">
					                                        <span class="docon docon-check-mark"></span>
				                                        </span>
			                                        </div>
		                                        </button>
	                                        </div>
                                            @Raw(example.Item2.ToHtml())
                                        }
                                    }

                                    @if (overload.Remarks != null)
                                    {
                                        if (reduceHeaderSize)
                                        {
                                            <h4 id="remarks" class="heading-anchor">Remarks</h4>
                                        }

                                        else
                                        {
                                            <h3 id="remarks" class="heading-anchor">Remarks</h3>
                                        }

                                        @Raw(overload.Remarks.ToHtml(), "p")
                                    }

                                    @if (overload.SeeAlso != null)
                                    {
                                        if (reduceHeaderSize)
                                        {
                                            <h4 class="propertyInfoTitle stack heading-anchor" id="see-also">See Also</h4>
                                        }

                                        else
                                        {
                                            <h3 class="propertyInfoTitle stack heading-anchor" id="see-also">See Also</h3>
                                        }

                                        <ul>
                                            @foreach (InsightDocs.DotNet.Model.XmlDocHtml seeAlso in overload.SeeAlso)
                                            {
                                                <li>@Raw(seeAlso.ToHtml())</li>
                                            }
                                        </ul>
                                    }

                                    @if (Item.Overloads.Count(o => o.DeclaringType != null && Item.DeclaringType != null && o.DeclaringType.Type == Item.DeclaringType.Type) > 1)
                                    {
                                        @Raw("</div>")
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>