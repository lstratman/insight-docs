@inherits InsightDocs.DotNet.RazorDotNetTemplate<InsightDocs.DotNet.Model.DotNetMethod>

<html>
    <head>
        <link rel="stylesheet" href="../../msdn.css"/>
    </head>
    <body>
        <main id="main" role="main" class="layout-body-main " data-bi-name="content" lang="en-us" dir="ltr">
            <div data-main-column="" class="padding-sm padding-top-none padding-top-sm-tablet">
				<div>
                    <div class="content">
                        <div data-chunk-ids="0">
                            <h1>@Item!.Title</h1>

                            <h2>Definition</h2>

                            <div class="metadata">
                                @if (Item.DeclaringType?.Namespace != null)
                                {
                                    <dl class="attributeList">
                                        <dt>Namespace:</dt>
                                        <dd>@GetLink(Item.DeclaringType.Namespace)</dd>
                                    </dl>
                                }

                                @if (!String.IsNullOrEmpty(Item.DeclaringType?.Assembly?.Name))
                                {
                                    <dl class="attributeList">
                                        <dt>Assembly:</dt>
                                        <dd>@Item.DeclaringType.Assembly.Name</dd>
                                    </dl>
                                }
                            </div>

                            @if (Item.Overloads.Count(o => o.DeclaringType != null && Item.DeclaringType != null && o.DeclaringType.Type == Item.DeclaringType.Type) > 1)
                            {
                                <h2 id="overloads">Overloads</h2>
                            }

                            @foreach (InsightDocs.DotNet.Model.DotNetMethodOverload overload in Item.Overloads.Where(o => o.DeclaringType != null && Item.DeclaringType != null && o.DeclaringType.Type == Item.DeclaringType.Type))
                            {
                                <div>
                                    @if (Item.Overloads.Count(o => o.DeclaringType != null && Item.DeclaringType != null && o.DeclaringType.Type == Item.DeclaringType.Type) > 1)
                                    {
                                        <div class="heading-wrapper" data-heading-level="h2">
                                            <h2 class="memberNameHolder heading-anchor">@overload.MemberDisplayName</h2>
                                        </div>

                                        @Raw("<div class=\"memberInfo\">")
                                    }

                                    @if (overload.Description != null)
                                    {
                                        <div class="summaryHolder">@Raw(overload.Description.ToHtml())</div>
                                    }

                                    <!-- TODO: code -->

                                    @if (overload.Parameters != null)
                                    {
                                        <h3 class="propertyInfoTitle stack heading-anchor" id="parameters">Parameters</h3>

                                        @for (int i = 0; i < overload.Parameters.Count; i++)
                                        {
                                            <div class="@(i == 0 ? "propertyInfo" : "propertyInfo stack")">
                                                <dl class="parameterList">
                                                    <dt>@overload.Parameters[i].Name</dt>
                                                    <dd>@GetLink(overload.Parameters[i].Type)</dd>
                                                </dl>

                                                @if (overload.Parameters[i].Description != null)
                                                {
                                                    <p>@Raw(overload.Parameters[i].Description!.ToHtml())</p>
                                                }
                                            </div>
                                        }
                                    }

                                    <h3 class="propertyInfoTitle stack">Returns</h3>

                                    <div class="propertyInfo">@GetLink(overload.ReturnType)</div>

                                    @if (overload.ReturnsDescription != null)
                                    {
                                        @Raw(overload.ReturnsDescription.ToHtml(), "p")
                                    }

                                    @if (overload.Exceptions != null)
                                    {
                                        <h3 class="propertyInfoTitle stack heading-anchor" id="exceptions">Exceptions</h3>

                                        foreach (Tuple<InsightDocs.DotNet.Model.XmlDocHtml, InsightDocs.DotNet.Model.XmlDocHtml?> exception in overload.Exceptions)
                                        {
                                            <div class="propertyInfo">
                                                <div class="subtle">
                                                    @Raw(exception.Item1.ToHtml())
                                                </div>
                                                
                                                @if (exception.Item2 != null)
                                                {
                                                    @Raw(exception.Item2.ToHtml(), "p")
                                                }
                                            </div>
                                        }
                                    }

                                    @if (overload.Remarks != null)
                                    {
                                        <h3 id="remarks" class="heading-anchor">Remarks</h3>

                                        @Raw(overload.Remarks.ToHtml(), "p")
                                    }

                                    @if (overload.SeeAlso != null)
                                    {
                                        <h3 class="propertyInfoTitle stack heading-anchor" id="see-also">See Also</h3>

                                        <ul>
                                            @foreach (InsightDocs.DotNet.Model.XmlDocHtml seeAlso in overload.SeeAlso)
                                            {
                                                <li>@Raw(seeAlso.ToHtml())</li>
                                            }
                                        </ul>
                                    }

                                    @if (Item.Overloads.Count(o => o.DeclaringType != null && Item.DeclaringType != null && o.DeclaringType.Type == Item.DeclaringType.Type) > 1)
                                    {
                                        @Raw("</div>")
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>